{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "lib": ["ES2021"],
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "vitest/globals"],
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*", "worker-configuration.d.ts", "projects.json", "projects.schema.json"],
  "exclude": ["node_modules", "**/dist", "**/.wrangler"]
}

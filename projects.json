        "v3.3.0-rc.2": { "version": "3.3.0-rc.2", "channels": ["rc"] },
        "v3.0.0-rc.0": { "version": "3.0.0-rc.0", "channels": ["rc"] },
        "v2.0.0": { "version": "2.0.0", "channels": ["stable", "rc"] },

export TF_VAR_tf_state_postgres_conn_str="op://tf/tf_state/postgres_conn_str"
export TF_VAR_env=$ENVIRONMENT

# The futo-version GitLab bot's API token, which creates each GitLab project's
# release hook and read token (gitlab.tf). core-infra-tf creates the bot, makes
# it a Maintainer of those projects and rotates the token
# (modules/shared/gitlab/futo).
export TF_VAR_gitlab_tofu_token="op://tf/FUTO_VERSION_GITLAB_TOFU_TOKEN/password"

# The version service's own GitHub App, which reads releases (Metadata and
# Contents: read) and delivers its release webhook to prod's /webhook.
# core-infra-tf mirrors its credentials into the tf vault (github_app_names in
# modules/shared/1password/account/secrets.tf) and generates the webhook secret
# (FUTO_VERSION_GITHUB_WEBHOOK_SECRET), which is also set in the app.
export TF_VAR_github_app_version_id="op://tf/GITHUB_APP_FUTO_VERSION/app_id"
export TF_VAR_github_app_version_pem_file="op://tf/GITHUB_APP_FUTO_VERSION/pkcs8"
export TF_VAR_github_app_version_webhook_secret="op://tf/FUTO_VERSION_GITHUB_WEBHOOK_SECRET/password"

# o11y vmauth gateway token for the matching store (tf_dev: staging, tf_prod: prod).
# Dev main and prod always ship and fail to plan without it; PR stages never
# ship (worker.tf). A reference that does not resolve makes op run fail every
# deploy and teardown. After FUTO rotates the token: apply core-infra-tf, then
# dispatch Build on main.
export TF_VAR_o11y_vmauth_token="op://tf_$ENVIRONMENT/O11Y_VICTORIAMETRICS_VMAUTH_PASSWORD/password"

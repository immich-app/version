export TF_VAR_tf_state_postgres_conn_str="op://tf/tf_state/postgres_conn_str"
export TF_VAR_env=$ENVIRONMENT

export TF_VAR_github_app_tofu_installation_id="op://tf/GITHUB_APP_IMMICH_TOFU/installation_id"
export TF_VAR_github_app_tofu_id="op://tf/GITHUB_APP_IMMICH_TOFU/app_id"
export TF_VAR_github_app_tofu_owner="op://tf/GITHUB_APP_IMMICH_TOFU/owner"
export TF_VAR_github_app_tofu_pem_file="op://tf/GITHUB_APP_IMMICH_TOFU/pkcs1"

export TF_VAR_github_app_readonly_id="op://tf/GITHUB_APP_IMMICH_READ_ONLY/app_id"
export TF_VAR_github_app_readonly_pem_file="op://tf/GITHUB_APP_IMMICH_READ_ONLY/pkcs8"
export TF_VAR_github_app_readonly_installation_id="op://tf/GITHUB_APP_IMMICH_READ_ONLY/installation_id"

# o11y vmauth gateway token for the matching store (tf_dev: staging, tf_prod: prod).
# Dev main and prod always ship and fail to plan without it; PR stages never
# ship (worker.tf). A reference that does not resolve makes op run fail every
# deploy and teardown. After FUTO rotates the token: apply core-infra-tf, then
# dispatch Build on main.
export TF_VAR_o11y_vmauth_token="op://tf_$ENVIRONMENT/O11Y_VICTORIAMETRICS_VMAUTH_PASSWORD/password"

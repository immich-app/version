{
  "name": "version",
  "version": "1.0.0",
  "description": "Version check and docs versions API for Immich",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist/version",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:projects": "vitest run src/projects.test.ts",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.34.0",
    "@octokit/auth-app": "^8.0.0",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.13.6",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.35.0"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "pnpm": ">=10.0.0"
  }
}
